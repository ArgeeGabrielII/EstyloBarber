generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
  VIEWER
}

enum InventoryType {
  RETAIL
  CONSUMABLE
  RETAIL_AND_CONSUMABLE
}

enum InventoryMovementType {
  INITIAL_BALANCE
  STOCK_IN
  SERVICE_USAGE
  ITEM_SALE
  VOID_SERVICE
  VOID_ITEM_SALE
  MANUAL_ADJUSTMENT
}

enum TransactionStatus {
  ACTIVE
  VOID
}

enum TransactionType {
  SERVICE
  ITEM
}

model User {
  id                  String               @id @default(uuid())
  username            String               @unique
  displayName         String
  passwordHash        String
  role                UserRole
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  checkouts            Checkout[]
  serviceTransactions ServiceTransaction[]
  itemTransactions    ItemTransaction[]
  inventoryMovements  InventoryMovement[]
  auditLogs           AuditLog[]
}

model Barber {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  active              Boolean              @default(true)
  displayOrder        Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  serviceTransactions ServiceTransaction[]
}

model Seat {
  id                  String               @id @default(uuid())
  number              Int                  @unique
  name                String
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  serviceTransactions ServiceTransaction[]
}

model Service {
  id                  String                  @id @default(uuid())
  code                String                  @unique
  name                String
  description         String?
  fee                 Decimal                 @db.Decimal(12, 2)
  durationMinutes     Int?
  displayOrder        Int                     @default(0)
  active              Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  inventoryUsage      ServiceInventoryUsage[]
  transactionLines    ServiceTransactionLine[]
}

model InventoryItem {
  id                  String                  @id @default(uuid())
  sku                 String                  @unique
  name                String
  description         String?
  type                InventoryType
  unit                String
  quantityOnHand      Decimal                 @default(0) @db.Decimal(12, 3)
  warningLevel        Decimal                 @default(0) @db.Decimal(12, 3)
  reorderLevel        Decimal                 @default(0) @db.Decimal(12, 3)
  cost                Decimal?                @db.Decimal(12, 2)
  sellingPrice        Decimal?                @db.Decimal(12, 2)
  active              Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  serviceUsage        ServiceInventoryUsage[]
  itemTransactionLines ItemTransactionLine[]
  movements           InventoryMovement[]
}

model ServiceInventoryUsage {
  id              String        @id @default(uuid())
  serviceId       String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(12, 3)
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([serviceId, inventoryItemId])
}

model Checkout {
  id                    String              @id @default(uuid())
  idempotencyKey        String              @unique
  cashierId             String
  createdAt             DateTime            @default(now())
  cashier               User                @relation(fields: [cashierId], references: [id])
  serviceTransaction    ServiceTransaction?
  itemTransaction       ItemTransaction?
}

model ServiceTransaction {
  id                  String                   @id @default(uuid())
  transactionId       String                   @unique
  checkoutId          String                   @unique
  cashierId           String
  barberId            String
  seatId              String
  serviceAmount       Decimal                  @db.Decimal(12, 2)
  tipAmount           Decimal                  @default(0) @db.Decimal(12, 2)
  status              TransactionStatus        @default(ACTIVE)
  voidedAt            DateTime?
  voidedBy            String?
  voidReason          String?
  createdAt           DateTime                 @default(now())
  checkout            Checkout                 @relation(fields: [checkoutId], references: [id])
  cashier             User                     @relation(fields: [cashierId], references: [id])
  barber              Barber                   @relation(fields: [barberId], references: [id])
  seat                Seat                     @relation(fields: [seatId], references: [id])
  lines               ServiceTransactionLine[]
}

model ServiceTransactionLine {
  id                   String             @id @default(uuid())
  serviceTransactionId String
  serviceId            String
  serviceCodeSnapshot  String
  serviceNameSnapshot  String
  unitPrice            Decimal            @db.Decimal(12, 2)
  quantity             Int                @default(1)
  lineTotal            Decimal            @db.Decimal(12, 2)
  serviceTransaction   ServiceTransaction @relation(fields: [serviceTransactionId], references: [id], onDelete: Cascade)
  service              Service            @relation(fields: [serviceId], references: [id])
}

model ItemTransaction {
  id              String                @id @default(uuid())
  transactionId   String                @unique
  checkoutId      String                @unique
  cashierId       String
  amount          Decimal               @db.Decimal(12, 2)
  status          TransactionStatus     @default(ACTIVE)
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?
  createdAt       DateTime              @default(now())
  checkout        Checkout              @relation(fields: [checkoutId], references: [id])
  cashier         User                  @relation(fields: [cashierId], references: [id])
  lines           ItemTransactionLine[]
}

model ItemTransactionLine {
  id                    String          @id @default(uuid())
  itemTransactionId     String
  inventoryItemId       String
  skuSnapshot           String
  itemNameSnapshot      String
  unitPrice             Decimal         @db.Decimal(12, 2)
  quantity              Decimal         @db.Decimal(12, 3)
  lineTotal             Decimal         @db.Decimal(12, 2)
  itemTransaction       ItemTransaction @relation(fields: [itemTransactionId], references: [id], onDelete: Cascade)
  inventoryItem         InventoryItem   @relation(fields: [inventoryItemId], references: [id])
}

model TransactionCounter {
  id              String          @id @default(uuid())
  businessDate    DateTime        @db.Date
  transactionType TransactionType
  currentValue    Int             @default(0)

  @@unique([businessDate, transactionType])
}

model InventoryMovement {
  id              String                @id @default(uuid())
  inventoryItemId String
  movementType    InventoryMovementType
  quantity        Decimal               @db.Decimal(12, 3)
  quantityBefore  Decimal               @db.Decimal(12, 3)
  quantityAfter   Decimal               @db.Decimal(12, 3)
  referenceType   String?
  referenceId     String?
  reason          String?
  createdById     String
  createdAt       DateTime              @default(now())
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id])
  createdBy       User                  @relation(fields: [createdById], references: [id])

  @@index([inventoryItemId, createdAt])
  @@index([referenceId])
}

model AuditLog {
  id         String   @id @default(uuid())
  event      String
  entityType String?
  entityId   String?
  userId     String
  oldValue   Json?
  newValue   Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
}

model ShopSetting {
  id            String   @id @default("default")
  shopName      String   @default("Estylo Barbers")
  currency      String   @default("PHP")
  timezone      String   @default("Asia/Manila")
  receiptHeader String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
